<?xml version="1.0" encoding="utf-8"?>
<!-- Payments to check (4x2): the rows an import counted with a guessed
     category or as To sort and nobody has opened yet. Each row is the
     merchant over a "Guessed <category>" or "To sort" pill, the amount, and
     Keep on a guessed row or a chevron on a To sort one. "+N more" counts
     the rest; with nothing waiting, "All checked". Fixed rows, no collection
     view: nothing for R8 to strip. HomeWidgets.checks shows as many rows as
     the height holds at the user's font size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/hw_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/budget_widget_bg"
        android:tint="#262A3A" />

    <ImageView
        android:id="@+id/hw_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_border"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hw_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/home_widget_checks_title"
                android:textColor="#B4C0C8"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/hw_head_go"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_chevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hw_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/hw_row1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/hw_name1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp">

                        <ImageView
                            android:id="@+id/hw_pill_bg1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_card_border" />

                        <TextView
                            android:id="@+id/hw_pill1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="1dp"
                            android:textColor="#4A90E2"
                            android:textSize="11sp" />
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/hw_amt1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/hw_keep1"
                    android:layout_width="56dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Keep guess">

                    <ImageView
                        android:id="@+id/hw_keep_bg1"
                        android:layout_width="56dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_card_border" />

                    <TextView
                        android:id="@+id/hw_keep_label1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:maxLines="1"
                        android:text="@string/home_widget_checks_keep"
                        android:textColor="#4A90E2"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/hw_go1"
                    android:layout_width="56dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_chevron"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:id="@+id/hw_div2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="2dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/budget_widget_bg"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/hw_row2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/hw_name2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp">

                        <ImageView
                            android:id="@+id/hw_pill_bg2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_card_border" />

                        <TextView
                            android:id="@+id/hw_pill2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="1dp"
                            android:textColor="#4A90E2"
                            android:textSize="11sp" />
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/hw_amt2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/hw_keep2"
                    android:layout_width="56dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Keep guess">

                    <ImageView
                        android:id="@+id/hw_keep_bg2"
                        android:layout_width="56dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_card_border" />

                    <TextView
                        android:id="@+id/hw_keep_label2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:maxLines="1"
                        android:text="@string/home_widget_checks_keep"
                        android:textColor="#4A90E2"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/hw_go2"
                    android:layout_width="56dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_chevron"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:id="@+id/hw_div3"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="2dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/budget_widget_bg"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/hw_row3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/hw_name3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp">

                        <ImageView
                            android:id="@+id/hw_pill_bg3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_card_border" />

                        <TextView
                            android:id="@+id/hw_pill3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="1dp"
                            android:textColor="#4A90E2"
                            android:textSize="11sp" />
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/hw_amt3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/hw_keep3"
                    android:layout_width="56dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Keep guess">

                    <ImageView
                        android:id="@+id/hw_keep_bg3"
                        android:layout_width="56dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_card_border" />

                    <TextView
                        android:id="@+id/hw_keep_label3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:maxLines="1"
                        android:text="@string/home_widget_checks_keep"
                        android:textColor="#4A90E2"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/hw_go3"
                    android:layout_width="56dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_chevron"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/hw_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B4C0C8"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/hw_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/hw_done_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_ic_check" />

                <TextView
                    android:id="@+id/hw_done_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_widget_checks_done"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/hw_done_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/home_widget_checks_done_hint"
                android:textColor="#B4C0C8"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hw_done_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/home_widget_checks_open"
                    android:textColor="#4A90E2"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/hw_done_link_go"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_ic_chevron" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/hw_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="@string/home_widget_empty"
            android:textColor="#B4C0C8"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
