<?xml version="1.0" encoding="utf-8"?>
<!-- Today and Add (4x1): on the left (opens today's transactions) the day's
     payments and imports to review, then the day's spend and, with a
     monthly budget, safe to spend; on the right an Add button (opens the
     Add expense sheet). Where a one-row cell with large text holds one
     line only, HomeWidgets.todayAdd hides the first line rather than clip
     both, and the review count moves into the second; where the first
     line is too wide, it drops the payment count before the review count. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/hw_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/budget_widget_bg"
        android:tint="#262A3A" />

    <ImageView
        android:id="@+id/hw_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_border"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingVertical="4dp">

        <LinearLayout
            android:id="@+id/hw_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hw_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/home_widget_today_title"
                android:textColor="#B4C0C8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/hw_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/hw_add"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:contentDescription="@string/shortcut_add_expense">

            <ImageView
                android:id="@+id/hw_add_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/budget_widget_bg"
                android:tint="#4A90E2" />

            <TextView
                android:id="@+id/hw_add_label"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:text="@string/home_widget_add"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
