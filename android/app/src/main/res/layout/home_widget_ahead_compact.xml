<?xml version="1.0" encoding="utf-8"?>
<!-- Expected balance (compact, 2x1): the lowest balance expected in the
     next 31 days and its day. Where the height cannot hold the three lines
     at the user's font size, HomeWidgets.aheadCompact drops the date first,
     then the title, so the figure never clips. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/hw_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/budget_widget_bg"
        android:tint="#262A3A" />

    <ImageView
        android:id="@+id/hw_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_border"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">

        <LinearLayout
            android:id="@+id/hw_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hw_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B4C0C8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/hw_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFB572"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hw_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B4C0C8"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/hw_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/home_widget_empty"
            android:textColor="#B4C0C8"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
