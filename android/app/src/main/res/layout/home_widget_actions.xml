<?xml version="1.0" encoding="utf-8"?>
<!-- Quick actions (4x1): three buttons, Expense (the accent fill, as the
     app's main button), Income and Import SMS. Each opens the app on its
     own launch action. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/hw_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/budget_widget_bg"
        android:tint="#262A3A" />

    <ImageView
        android:id="@+id/hw_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_border"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="6dp">

        <FrameLayout
            android:id="@+id/hw_act_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:contentDescription="@string/shortcut_add_expense">

            <ImageView
                android:id="@+id/hw_act_expense_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/budget_widget_bg"
                android:tint="#4A90E2" />

            <TextView
                android:id="@+id/hw_act_expense_label"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:text="@string/home_widget_action_expense"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/hw_act_income"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:contentDescription="@string/shortcut_add_income">

            <ImageView
                android:id="@+id/hw_act_income_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/budget_widget_bg"
                android:tint="#3B3F4F" />

            <TextView
                android:id="@+id/hw_act_income_label"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:text="@string/home_widget_action_income"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/hw_act_import"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:contentDescription="@string/shortcut_import_sms">

            <ImageView
                android:id="@+id/hw_act_import_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/budget_widget_bg"
                android:tint="#3B3F4F" />

            <TextView
                android:id="@+id/hw_act_import_label"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:text="@string/shortcut_import_sms"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
