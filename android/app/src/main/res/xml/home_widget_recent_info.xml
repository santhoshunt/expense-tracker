<?xml version="1.0" encoding="utf-8"?>
<!-- Recent (4x2). updatePeriodMillis: a 30-minute redraw from the stored
     snapshot (Android's floor), so "Today" and "Yesterday" move on after
     midnight without the app running. No configure step. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/home_widget_recent_description"
    android:initialLayout="@layout/home_widget_recent"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:previewLayout="@layout/home_widget_recent_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
