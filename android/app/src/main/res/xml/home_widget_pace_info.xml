<?xml version="1.0" encoding="utf-8"?>
<!-- Month pace (4×2). updatePeriodMillis: a 30-minute redraw from the stored
     snapshot (Android's floor), so "today" and the pace marker move on
     after midnight without the app running. No configure step. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/home_widget_pace_description"
    android:initialLayout="@layout/home_widget_pace"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:previewLayout="@layout/home_widget_pace"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />