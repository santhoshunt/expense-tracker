<?xml version="1.0" encoding="utf-8"?>
<!-- Expected balance (4x2). updatePeriodMillis: a 30-minute redraw from the
     stored snapshot (Android's floor), so the days gone by drop off and the
     dates move on after midnight without the app running. No configure
     step. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/home_widget_ahead_description"
    android:initialLayout="@layout/home_widget_ahead"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:previewLayout="@layout/home_widget_ahead_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
