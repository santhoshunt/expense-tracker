<?xml version="1.0" encoding="utf-8"?>
<!-- Big bills (compact, 4x1). updatePeriodMillis: a 30-minute redraw from
     the stored snapshot (Android's floor), so a bill past its grace days
     drops off without the app running. No configure step. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/home_widget_big_bills_compact_description"
    android:initialLayout="@layout/home_widget_big_bills_compact"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:previewLayout="@layout/home_widget_big_bills_compact_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
