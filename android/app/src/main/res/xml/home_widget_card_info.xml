<?xml version="1.0" encoding="utf-8"?>
<!-- Card cycle and rewards (4x2). updatePeriodMillis: a 30-minute redraw
     from the stored snapshot (Android's floor), so the statement countdown
     and the due date move on after midnight without the app running. Each
     instance shows the card picked in CardWidgetConfigActivity, which opens
     when the widget is added and again from the long-press menu
     (reconfigurable, from Android 12). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.fabletest.expense_tracker.CardWidgetConfigActivity"
    android:description="@string/home_widget_card_description"
    android:initialLayout="@layout/home_widget_card"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:previewLayout="@layout/home_widget_card_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
