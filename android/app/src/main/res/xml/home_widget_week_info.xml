<?xml version="1.0" encoding="utf-8"?>
<!-- This week (4x2). updatePeriodMillis: a 30-minute redraw from the stored
     snapshot (Android's floor), so the usual week moves to each new day and
     a new Monday starts at zero without the app running. No configure
     step. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/home_widget_week_description"
    android:initialLayout="@layout/home_widget_week"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:previewLayout="@layout/home_widget_week_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
