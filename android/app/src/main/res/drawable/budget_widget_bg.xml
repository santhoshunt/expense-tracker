<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card shape, shared by every widget and by their buttons. White so
     the provider's colour filter paints it the app's card fill (or a
     button's colour) exactly; the layouts' default tint is the dark kit's
     card. Same 16dp corners as the app's cards. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <corners android:radius="16dp" />
</shape>
