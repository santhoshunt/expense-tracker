<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded progress track: coral fill (the app accent) over a charcoal
     groove. Colour never carries the over-budget state alone — the status
     text says it in words too. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#3B3F4F" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="4dp" />
                <solid android:color="#EA7C69" />
            </shape>
        </clip>
    </item>
</layer-list>
