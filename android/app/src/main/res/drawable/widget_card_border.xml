<?xml version="1.0" encoding="utf-8"?>
<!-- The card's 1dp hairline, drawn over budget_widget_bg and filtered to the
     theme's border colour. Shown only where the app outlines its cards (the
     light theme and the near-black palettes); a colour filter tints a whole
     drawable, so the fill and the line need a layer each. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
    <stroke
        android:width="1dp"
        android:color="#FFFFFFFF" />
    <corners android:radius="16dp" />
</shape>
